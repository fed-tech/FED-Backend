model Payment {
  id          String   @id @default(cuid()) @map("_id") // Unique payment ID
  eventTitle    String   // Associated event ID
  orderId     String   // Razorpay order ID
  paymentId   String?  // Razorpay payment ID
  amount      Int      // Payment amount in paise
  currency    String   @default("INR")
  status      String   @default("PENDING") // Status: PENDING, SUCCESS, FAILED
  createdAt   DateTime @default(now())     // Timestamp of payment creation
  updatedAt   DateTime @updatedAt          // Timestamp of last update

  event       Event    @relation(fields: [eventTitle], references: [id]) // Define relation to Event
}

model Event {
  id          String   @id @default(cuid()) @map("_id") // Event ID
  name        String
  description String
  date        DateTime
  payments    Payment[] // Define relation to Payment
}

